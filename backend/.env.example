# Copy to .env (here, in the app folder, or any parent folder) and fill in. Never commit the real .env.
# Preferred: route model calls through Portkey.
PORTKEY_API_KEY=
# Alternative: call OpenAI directly (only needed if PORTKEY_API_KEY is not set).
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Comma-separated origins allowed to call the API from a browser.
# CORS_ORIGINS=http://localhost:5173
